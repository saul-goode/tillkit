{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install && pnpm build",
  "outputDirectory": "templates/starter/dist",
  "installCommand": "corepack enable && pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/styles.css", "destination": "/styles.css" },
    { "source": "/(.*)", "destination": "/index.js" }
  ],
  "github": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
