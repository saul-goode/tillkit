# Database
DATABASE_URL=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (optional)
# PAYPAL_WEBHOOK_ID is REQUIRED to receive PayPal webhooks. Without it the
# webhook route fails closed: events cannot be verified, so none are processed.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# Meilisearch (optional)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=products

# Inventory webhooks (optional)
# External system to notify when stock changes on order pay
# INVENTORY_WEBHOOK_URL=
# INVENTORY_WEBHOOK_SECRET=
