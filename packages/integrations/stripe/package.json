{
  "name": "@tillkit/integration-stripe",
  "version": "0.0.1",
  "description": "TillKit Stripe payment integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
